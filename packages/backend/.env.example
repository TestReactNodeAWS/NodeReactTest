# Copy to .env for local runs. Names match RTC's backend settings so the same
# keys move into the Kubernetes ConfigMap (non-secret) and Secret (secret) later.

NODE_ENV=development
APP_NAME=lab-backend
PORT=5010
CORS_ALLOWED=http://localhost:3000,http://localhost:8080

# Database. DB_HOST, DB_USER and DB_PASSWORD are secrets in real environments.
# 5433 is the lab Postgres from docker/docker-compose.yml (5432 is left for a local Postgres).
DB_HOST=localhost
DB_PORT=5433
DB_USER=lab
DB_PASSWORD=lab
DB_DATABASE=lab
DB_SSL_ENABLED=false
