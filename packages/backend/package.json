{
  "name": "@lab/backend",
  "version": "1.0.0",
  "private": true,
  "description": "Lab API with the same layering as RTC's v2 backend (services, repositories, entities, controllers under /api/v2).",
  "main": "build/server.js",
  "scripts": {
    "dev": "tsc -p tsconfig.build.json && node build/server.js",
    "build": "rimraf build && tsc -p tsconfig.build.json",
    "start": "node build/server.js",
    "lint": "npm run lint:type-check && npm run lint:eslint",
    "lint:type-check": "tsc --noEmit",
    "lint:eslint": "eslint \"src/**/*.ts\"",
    "test": "jest --testPathIgnorePatterns=src/__tests__/integration",
    "test:pr": "jest --ci --changedSince=origin/main --passWithNoTests --testPathIgnorePatterns=src/__tests__/integration",
    "test:nightly": "jest --ci --coverage --testPathIgnorePatterns=src/__tests__/integration",
    "test:integrationTests": "jest --ci --runInBand --forceExit src/__tests__/integration"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "pg": "^8.13.1",
    "reflect-metadata": "^0.2.2",
    "typedi": "^0.10.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "@types/supertest": "^6.0.2",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "rimraf": "^6.0.1",
    "supertest": "^7.0.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.1"
  }
}
